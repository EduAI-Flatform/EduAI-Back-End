NODE_ENV=development
PORT=3000

# Production must use a least-privilege runtime role here and the separate
# root-only .env.migration file described by .env.migration.example.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduai
REDIS_URL=

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PUBLIC_APP_URL=http://localhost:5173
DEMO_ACCOUNT_PASSWORD=

AI_PROVIDER=gemini
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional generic fallback, used only when AI_PROVIDER=gemini.
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

# Optional future provider configuration. These are never used as Gemini fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
MAX_VIDEO_UPLOAD_SIZE=2147483648
MAX_DOCUMENT_UPLOAD_SIZE=52428800

# Optional vendor-neutral structured error collector.
MONITORING_ENABLED=false
MONITORING_ENDPOINT=

# Permanent Phase 3 Commerce uses a dedicated HMAC secret for idempotency keys.
COMMERCE_IDEMPOTENCY_SECRET=replace-with-at-least-32-random-characters

# PayOS has no sandbox API. Keep disabled until the separately approved live
# payment release gate. All values are server-only and must never reach clients.
PAYOS_ENVIRONMENT=disabled
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=
PAYOS_CANCEL_URL=
PAYOS_WEBHOOK_URL=
PAYOS_TIMEOUT_MS=10000
