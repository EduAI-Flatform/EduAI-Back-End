NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eduai
REDIS_URL=

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PUBLIC_APP_URL=http://localhost:5173
DEMO_ACCOUNT_PASSWORD=

AI_PROVIDER=gemini
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Optional generic fallback, used only when AI_PROVIDER=gemini.
AI_API_KEY=
AI_MODEL=
AI_EMBEDDING_MODEL=

# Optional future provider configuration. These are never used as Gemini fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
MAX_VIDEO_UPLOAD_SIZE=2147483648
MAX_DOCUMENT_UPLOAD_SIZE=52428800

# Optional vendor-neutral structured error collector.
MONITORING_ENABLED=false
MONITORING_ENDPOINT=

# Phase 3 Commerce entry points remain opt-in until production gates pass.
COMMERCE_ENABLED=false
