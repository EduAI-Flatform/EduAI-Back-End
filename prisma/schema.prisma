model VoucherCategory {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId    String  @map("voucher_id") @db.Uuid
  categorySlug String  @map("category_slug")
  voucher      Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, categorySlug])
  @@index([categorySlug])
  @@map("voucher_categories")
}

model VoucherUser {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId String  @map("voucher_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId])
  @@index([userId])
  @@map("voucher_users")
}

model VoucherRedemption {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId            String   @map("voucher_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  courseId             String   @map("course_id") @db.Uuid
  redemptionKey        String   @map("redemption_key")
  originalAmountMinor  Int      @map("original_amount_minor")
  discountAmountMinor  Int      @map("discount_amount_minor")
  finalAmountMinor     Int      @map("final_amount_minor")
  currency             String   @db.VarChar(3)
  createdAt            DateTime @default(now()) @map("created_at")
  voucher              Voucher  @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([voucherId, userId, redemptionKey])
  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@map("voucher_redemptions")
}

model ScholarshipCampaign {
  id              String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String?
  status          ScholarshipStatus          @default(draft)
  applicationMode ScholarshipApplicationMode @map("application_mode")
  benefitKind     ScholarshipBenefitKind     @map("benefit_kind")
  benefitValue    Int                        @map("benefit_value")
  currency        String?                    @db.VarChar(3)
  startsAt        DateTime                   @map("starts_at")
  endsAt          DateTime                   @map("ends_at")
  quota           Int?
  awardedCount    Int                        @default(0) @map("awarded_count")
  createdById     String                     @map("created_by_id") @db.Uuid
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  createdBy       User                       @relation("ScholarshipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  courseScopes    ScholarshipCourse[]
  categoryScopes  ScholarshipCategory[]
  eligibleUsers   ScholarshipUser[]
  applications    ScholarshipApplication[]
  awards          ScholarshipAward[]

  @@index([status, startsAt, endsAt])
  @@index([createdById])
  @@map("scholarship_campaigns")
}

model ScholarshipCourse {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholarshipId String              @map("scholarship_id") @db.Uuid
  courseId      String              @map("course_id") @db.Uuid
  scholarship   ScholarshipCampaign @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, courseId])
  @@index([courseId])
  @@map("scholarship_courses")
}

model ScholarshipCategory {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholarshipId String              @map("scholarship_id") @db.Uuid
  categorySlug  String              @map("category_slug")
  scholarship   ScholarshipCampaign @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, categorySlug])
  @@index([categorySlug])
  @@map("scholarship_categories")
}

model ScholarshipUser {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholarshipId String              @map("scholarship_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  scholarship   ScholarshipCampaign @relation(fields: [scholarshipId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scholarshipId, userId])
  @@index([userId])
  @@map("scholarship_users")
}

model ScholarshipApplication {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholarshipId String                       @map("scholarship_id") @db.Uuid
  userId        String                       @map("user_id") @db.Uuid
  courseId      String                       @map("course_id") @db.Uuid
  status        ScholarshipApplicationStatus @default(pending)
  decisionReason String?                     @map("decision_reason")
  appliedAt     DateTime                     @default(now()) @map("applied_at")
  updatedAt     DateTime                     @updatedAt @map("updated_at")
  scholarship   ScholarshipCampaign           @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)
  user          User                          @relation(fields: [userId], references: [id], onDelete: Restrict)
  course        Course                        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  award         ScholarshipAward?

  @@unique([scholarshipId, userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("scholarship_applications")
}

model ScholarshipAward {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholarshipId String              @map("scholarship_id") @db.Uuid
  applicationId String              @unique @map("application_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  courseId      String              @map("course_id") @db.Uuid
  benefitKind   ScholarshipBenefitKind @map("benefit_kind")
  benefitValue  Int                 @map("benefit_value")
  currency      String?             @db.VarChar(3)
  awardedAt     DateTime            @default(now()) @map("awarded_at")
  revokedAt     DateTime?           @map("revoked_at")
  scholarship   ScholarshipCampaign @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)
  application   ScholarshipApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  user          User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  commerceReservations CommercePromotionReservation[]

  @@index([userId, courseId])
  @@index([scholarshipId, awardedAt])
  @@map("scholarship_awards")
}

model TmiReward {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title            String
  description      String?
  kind             TmiRewardKind
  cost             Int
  status           TmiRewardStatus @default(draft)
  quota            Int?
  redeemedCount   Int             @default(0) @map("redeemed_count")
  startsAt         DateTime        @map("starts_at")
  endsAt           DateTime        @map("ends_at")
  inventoryMetadata Json?          @map("inventory_metadata")
  createdById      String          @map("created_by_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  createdBy        User            @relation("TmiRewardCreator", fields: [createdById], references: [id], onDelete: Restrict)
  redemptions      TmiRedemption[]

  @@index([status, startsAt, endsAt])
  @@index([createdById])
  @@map("tmi_rewards")
}

model TmiRedemption {
  idempotencyKey String   @map("idempotency_key")
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  rewardId       String   @map("reward_id") @db.Uuid
  cost           Int
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reward         TmiReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  ledgerEntries  TmiLedgerEntry[]
  entitlement    TmiEntitlement?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([rewardId, createdAt])
  @@map("tmi_redemptions")
}

model TmiLedgerEntry {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  redemptionId        String?                  @map("redemption_id") @db.Uuid
  kind                TmiLedgerKind
  amount              Int
  adjustmentDirection TmiAdjustmentDirection? @map("adjustment_direction")
  sourceType          String                   @map("source_type")
  sourceId            String                   @map("source_id")
  actorId             String                   @map("actor_id") @db.Uuid
  metadata            Json?
  occurredAt          DateTime                 @default(now()) @map("occurred_at")
  expiresAt           DateTime?                @map("expires_at")
  user                User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  redemption          TmiRedemption?           @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@unique([userId, kind, sourceType, sourceId])
  @@index([userId, occurredAt])
  @@index([redemptionId])
  @@map("tmi_ledger_entries")
}

model TmiEntitlement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  redemptionId    String                @unique @map("redemption_id") @db.Uuid
  kind            TmiRewardKind
  status          TmiEntitlementStatus  @default(active)
  benefitMetadata Json?                 @map("benefit_metadata")
  createdAt       DateTime              @default(now()) @map("created_at")
  revokedAt       DateTime?             @map("revoked_at")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  redemption      TmiRedemption         @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@map("tmi_entitlements")
}
