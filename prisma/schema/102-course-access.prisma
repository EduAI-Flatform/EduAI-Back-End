enum CourseAccessSourceType {
  course_purchase
  membership
  scholarship
  tmi_reward
  admin
  free_enrollment
  legacy_enrollment

  @@map("course_access_source_type")
}

enum CourseAccessGrantStatus {
  active
  revoked

  @@map("course_access_grant_status")
}

model CourseAccessGrant {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                  @map("user_id") @db.Uuid
  courseId         String                  @map("course_id") @db.Uuid
  sourceType       CourseAccessSourceType  @map("source_type")
  sourceId         String                  @map("source_id") @db.VarChar(128)
  status           CourseAccessGrantStatus @default(active)
  startsAt         DateTime                @map("starts_at")
  endsAt           DateTime?               @map("ends_at")
  graceEndsAt      DateTime?               @map("grace_ends_at")
  revokedAt        DateTime?               @map("revoked_at")
  revocationReason String?                 @map("revocation_reason") @db.VarChar(120)
  createdAt        DateTime                @default(now()) @map("created_at")
  user             User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([userId, courseId, sourceType, sourceId], map: "course_access_grants_source_key")
  @@index([userId, courseId, status, startsAt, endsAt, graceEndsAt])
  @@index([sourceType, sourceId])
  @@map("course_access_grants")
}

model CourseAccessBackfillIssue {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enrollmentId String     @unique @map("enrollment_id") @db.Uuid
  status       String     @db.VarChar(64)
  reasonCode   String     @map("reason_code") @db.VarChar(64)
  recordedAt   DateTime   @default(now()) @map("recorded_at")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)

  @@index([reasonCode, recordedAt])
  @@map("course_access_backfill_issues")
}
