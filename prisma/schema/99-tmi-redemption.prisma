model TmiRedemption {
  idempotencyKey String   @map("idempotency_key")
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  rewardId       String   @map("reward_id") @db.Uuid
  cost           Int
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  reward         TmiReward @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  ledgerEntries  TmiLedgerEntry[]
  entitlement    TmiEntitlement?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([rewardId, createdAt])
  @@map("tmi_redemptions")
}

model TmiLedgerEntry {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String                   @map("user_id") @db.Uuid
  redemptionId        String?                  @map("redemption_id") @db.Uuid
  kind                TmiLedgerKind
  amount              Int
  adjustmentDirection TmiAdjustmentDirection? @map("adjustment_direction")
  sourceType          String                   @map("source_type")
  sourceId            String                   @map("source_id")
  actorId             String                   @map("actor_id") @db.Uuid
  metadata            Json?
  occurredAt          DateTime                 @default(now()) @map("occurred_at")
  expiresAt           DateTime?                @map("expires_at")
  user                User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  redemption          TmiRedemption?           @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@unique([userId, kind, sourceType, sourceId])
  @@index([userId, occurredAt])
  @@index([redemptionId])
  @@map("tmi_ledger_entries")
}

model TmiEntitlement {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  redemptionId    String                @unique @map("redemption_id") @db.Uuid
  kind            TmiRewardKind
  status          TmiEntitlementStatus  @default(active)
  benefitMetadata Json?                 @map("benefit_metadata")
  createdAt       DateTime              @default(now()) @map("created_at")
  revokedAt       DateTime?             @map("revoked_at")
  user            User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  redemption      TmiRedemption         @relation(fields: [redemptionId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@map("tmi_entitlements")
}
