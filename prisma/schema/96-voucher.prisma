model Voucher {
  id                       String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                     String        @unique
  status                   VoucherStatus @default(draft)
  kind                     VoucherKind
  value                    Int
  currency                 String        @db.VarChar(3)
  startsAt                 DateTime      @map("starts_at")
  endsAt                   DateTime      @map("ends_at")
  minimumCoursePriceMinor  Int?          @map("minimum_course_price_minor")
  maximumDiscountMinor     Int?          @map("maximum_discount_minor")
  usageLimit               Int?          @map("usage_limit")
  redeemedCount            Int           @default(0) @map("redeemed_count")
  perUserLimit             Int?          @map("per_user_limit")
  createdById              String        @map("created_by_id") @db.Uuid
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  createdBy                User          @relation("VoucherCreator", fields: [createdById], references: [id], onDelete: Restrict)
  courseScopes             VoucherCourse[]
  categoryScopes           VoucherCategory[]
  eligibleUsers            VoucherUser[]
  redemptions              VoucherRedemption[]

  @@index([status, startsAt, endsAt])
  @@index([createdById])
  @@map("vouchers")
}

model VoucherCourse {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId String  @map("voucher_id") @db.Uuid
  courseId  String  @map("course_id") @db.Uuid
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([voucherId, courseId])
  @@index([courseId])
  @@map("voucher_courses")
}

model VoucherCategory {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId    String  @map("voucher_id") @db.Uuid
  categorySlug String  @map("category_slug")
  voucher      Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@unique([voucherId, categorySlug])
  @@index([categorySlug])
  @@map("voucher_categories")
}

model VoucherUser {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId String  @map("voucher_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId])
  @@index([userId])
  @@map("voucher_users")
}

model VoucherRedemption {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  voucherId            String   @map("voucher_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  courseId             String   @map("course_id") @db.Uuid
  redemptionKey        String   @map("redemption_key")
  originalAmountMinor  Int      @map("original_amount_minor")
  discountAmountMinor  Int      @map("discount_amount_minor")
  finalAmountMinor     Int      @map("final_amount_minor")
  currency             String   @db.VarChar(3)
  createdAt            DateTime @default(now()) @map("created_at")
  voucher              Voucher  @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  course               Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@unique([voucherId, userId, redemptionKey])
  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@map("voucher_redemptions")
}
