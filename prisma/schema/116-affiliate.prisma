model AffiliateIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId String @map("owner_id") @db.Uuid
  kind String @db.VarChar(16)
  code String @unique @db.VarChar(40)
  status String @default("active") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")
  owner User @relation("AffiliateIdentityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  visits AffiliateVisit[]
  attributions AffiliateAttribution[]
  @@unique([ownerId, kind])
  @@map("affiliate_identities")
}
model AffiliateVisit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.VarChar(64)
  identityId String @map("identity_id") @db.Uuid
  policyRevisionId String @map("policy_revision_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")
  identity AffiliateIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  policy PlatformPolicyRevision @relation("AffiliateVisitPolicy", fields: [policyRevisionId], references: [id], onDelete: Restrict)
  attributions AffiliateAttribution[]
  @@index([expiresAt])
  @@map("affiliate_visits")
}
model AffiliateAttribution {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid
  identityId String @map("identity_id") @db.Uuid
  buyerId String @map("buyer_id") @db.Uuid
  visitId String @map("visit_id") @db.Uuid
  policyRevisionId String @map("policy_revision_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  identity AffiliateIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  buyer User @relation("AffiliateAttributionBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  visit AffiliateVisit @relation(fields: [visitId], references: [id], onDelete: Restrict)
  policy PlatformPolicyRevision @relation("AffiliateAttributionPolicy", fields: [policyRevisionId], references: [id], onDelete: Restrict)
  accruals AffiliateAccrual[]
  @@index([identityId, createdAt])
  @@map("affiliate_attributions")
}
model AffiliateAccrual {
  walletEffect AffiliateWalletEffect?
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributionId String @map("attribution_id") @db.Uuid
  sourceDigest String @map("source_digest") @db.VarChar(64)
  deltaMinor BigInt @map("delta_minor")
  qualifyingAmountMinor BigInt @map("qualifying_amount_minor")
  commissionBps Int @map("commission_bps")
  currency String @db.VarChar(3)
  holdUntil DateTime @map("hold_until")
  createdAt DateTime @default(now()) @map("created_at")
  attribution AffiliateAttribution @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  @@unique([attributionId, sourceDigest])
  @@index([attributionId, createdAt])
  @@map("affiliate_accruals")
}
