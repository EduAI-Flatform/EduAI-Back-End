model User {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String             @unique
  passwordHash  String?            @map("password_hash")
  fullName      String             @map("full_name")
  avatarUrl     String?            @map("avatar_url")
  avatarStorageKey String?         @map("avatar_storage_key")
  firebaseUid   String?            @unique @map("firebase_uid")
  authProvider  AuthProvider       @default(local) @map("auth_provider")
  emailVerified Boolean            @default(false) @map("email_verified")
  status        UserStatus         @default(active)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")
  roles         UserRole[]
  refreshTokens RefreshToken[]
  profile       UserProfile?
  learningProfile LearningProfile?
  skills        UserSkill[]
  portfolios    Portfolio[]
  courses       Course[]
  enrollments   Enrollment[]
  progress      LearningProgress[]
  quizAttempts  QuizAttempt[]
  submissions   Submission[]       @relation("SubmissionStudent")
  gradedSubmissions Submission[]   @relation("SubmissionGrader")
  classroomSessions ClassroomSession[] @relation("ClassroomSessionInstructor")
  classroomAttendance ClassroomAttendance[] @relation("ClassroomAttendanceUser")
  libraryResources LibraryResource[] @relation("LibraryResourceOwner")
  savedResources SavedResource[]
  communityPosts CommunityPost[]  @relation("CommunityPostAuthor")
  communityComments CommunityComment[] @relation("CommunityCommentAuthor")
  communityReactions CommunityReaction[]
  aiConversations AiConversation[]
  aiLearningPaths AiLearningPath[]
  aiGeneratedQuizzes AiGeneratedQuiz[]
  aiFlashcards AiFlashcard[]
  certificates  Certificate[]
  courseReviews CourseReview[]
  auditLogs     AuditLog[]
  createdVouchers Voucher[] @relation("VoucherCreator")
  eligibleVouchers VoucherUser[]
  voucherRedemptions VoucherRedemption[]
  createdScholarships ScholarshipCampaign[] @relation("ScholarshipCreator")
  scholarshipEligibleCampaigns ScholarshipUser[]
  scholarshipApplications ScholarshipApplication[]
  scholarshipAwards ScholarshipAward[]
  createdTmiRewards TmiReward[] @relation("TmiRewardCreator")
  tmiLedgerEntries TmiLedgerEntry[]
  tmiRedemptions TmiRedemption[]
  tmiEntitlements TmiEntitlement[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  createdJobs JobOpportunity[] @relation("JobOpportunityCreator")
  savedJobs SavedJob[]
  jobApplications JobApplication[] @relation("JobApplicationApplicant")
  jobApplicationChanges JobApplicationStatusHistory[] @relation("JobApplicationStatusActor")
  mentorProfile MentorProfile? @relation("MentorOwner")
  approvedMentorProfiles MentorProfile[] @relation("MentorApprover")

  @@index([status])
  @@index([deletedAt])
  @@map("users")
}
