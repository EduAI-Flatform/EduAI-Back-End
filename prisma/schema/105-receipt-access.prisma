model CommerceReceiptAccessGeneration {
  id String @id @db.Uuid
  orderId String @map("order_id") @db.Uuid
  claimId String @map("claim_id") @db.Uuid
  buyerId String @map("buyer_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  generation Int
  status String @default("ACCESS_UNVERIFIED") @db.VarChar(24)
  accessStartsAt DateTime @map("access_starts_at")
  createdAt DateTime @default(now()) @map("created_at")
  closedAt DateTime? @map("closed_at")
  settlementId String? @map("settlement_id") @db.Uuid
  order CommerceOrder @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  claim CommerceBankReceiptClaim @relation(fields: [claimId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  buyer User @relation("ReceiptAccessBuyer", fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User @relation("ReceiptAccessCreator", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  effects CommerceReceiptAccessEffect[]
  events CommerceReceiptAccessEvent[]
  @@unique([orderId,generation])
  @@index([buyerId,status])
  @@map("commerce_receipt_access_generations")
}

model CommerceReceiptAccessEffect {
  id String @id @db.Uuid
  generationId String @map("generation_id") @db.Uuid
  orderLineId String @map("order_line_id") @db.Uuid
  effectKind String @map("effect_kind") @db.VarChar(32)
  resourceType String @map("resource_type") @db.VarChar(32)
  resourceId String @unique @map("resource_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  generation CommerceReceiptAccessGeneration @relation(fields: [generationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  orderLine CommerceOrderLine @relation(fields: [orderLineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@index([generationId,effectKind])
  @@map("commerce_receipt_access_effects")
}

model CommerceReceiptAccessEvent {
  id String @id @db.Uuid
  generationId String @map("generation_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(24)
  operationKeyHash String @map("operation_key_hash") @db.VarChar(64)
  requestHash String @map("request_hash") @db.VarChar(64)
  reasonDigest String @map("reason_digest") @db.VarChar(64)
  reason String @db.VarChar(300)
  createdAt DateTime @default(now()) @map("created_at")
  generation CommerceReceiptAccessGeneration @relation(fields: [generationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor User @relation("ReceiptAccessActor", fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@unique([actorId,operationKeyHash])
  @@map("commerce_receipt_access_events")
}
