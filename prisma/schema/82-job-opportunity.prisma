model JobOpportunity {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdById    String             @map("created_by_id") @db.Uuid
  title          String
  companyName    String             @map("company_name")
  summary        String
  description    String
  location       String?
  workMode       JobWorkMode        @map("work_mode")
  employmentType JobEmploymentType  @map("employment_type")
  salaryMin      Int?               @map("salary_min")
  salaryMax      Int?               @map("salary_max")
  salaryCurrency String?            @map("salary_currency") @db.VarChar(3)
  status         JobStatus          @default(draft)
  publishedAt    DateTime?          @map("published_at")
  closesAt       DateTime?          @map("closes_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")
  createdBy      User               @relation("JobOpportunityCreator", fields: [createdById], references: [id], onDelete: Restrict)
  requiredSkills JobRequiredSkill[]
  savedBy        SavedJob[]
  applications   JobApplication[]

  @@index([status, closesAt])
  @@index([companyName])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("job_opportunities")
}

model JobRequiredSkill {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId     String         @map("job_id") @db.Uuid
  name      String
  level     String?
  createdAt DateTime       @default(now()) @map("created_at")
  job       JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, name])
  @@index([name])
  @@map("job_required_skills")
}

enum JobStatus {
  draft
  published
  closed

  @@map("job_status")
}

enum JobWorkMode {
  remote
  hybrid
  onsite

  @@map("job_work_mode")
}

enum JobEmploymentType {
  full_time
  part_time
  internship
  contract

  @@map("job_employment_type")
}

model SavedJob {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  jobId     String         @map("job_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at")
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       JobOpportunity @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

model JobApplication {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  jobId       String                 @map("job_id") @db.Uuid
  coverLetter String?                @map("cover_letter")
  status      JobApplicationStatus   @default(submitted)
  submittedAt DateTime               @default(now()) @map("submitted_at")
  withdrawnAt DateTime?              @map("withdrawn_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  user        User                   @relation("JobApplicationApplicant", fields: [userId], references: [id], onDelete: Restrict)
  job         JobOpportunity         @relation(fields: [jobId], references: [id], onDelete: Restrict)
  history     JobApplicationStatusHistory[]

  @@unique([userId, jobId])
  @@index([jobId, status])
  @@index([userId, submittedAt])
  @@map("job_applications")
}

model JobApplicationStatusHistory {
  id            String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String                @map("application_id") @db.Uuid
  fromStatus    JobApplicationStatus? @map("from_status")
  toStatus      JobApplicationStatus  @map("to_status")
  changedById   String                @map("changed_by_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")
  application   JobApplication        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy     User                  @relation("JobApplicationStatusActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@map("job_application_status_history")
}

enum JobApplicationStatus {
  submitted
  reviewing
  shortlisted
  accepted
  rejected
  withdrawn

  @@map("job_application_status")
}
